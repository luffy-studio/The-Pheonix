# Supabase Configuration (Frontend - Safe for browser)
# Get these from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Backend API URL
# For local development
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# WARNING: NEVER ADD SUPABASE_SERVICE_ROLE_KEY OR NEXT_PUBLIC_SUPABASE_SERVICE_ROLE_KEY HERE!
# Service role keys must only exist on the trusted backend server.
